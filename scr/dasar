<soal>
    <GRID> (ketik jumlah kolom terus enter)
        .w3-row>.w3-col.s6*
        .w3-row>.w3-col.m6*
        .w3-row>.w3-col.l6*
    </GRID>

    MEDIA (ketik 1 terus enter)
    div.media>img.mr-3[src]>div.media-body>h5.mt-0*

    <PILIHAN-GANDA-TANPA-GAP> (ketik 1 terus enter)
        .w3-row>(.w3-col.s6>ol.pas1[type="A"]>li{A}+li{B}+li{C})+.w3-col.s6>ol.pas1[start="4" type="A"]>li{D}+li{E}*
        .row>(.col>ol.pas1[type="A"]>li{\$A\$}+li{\$B\$})+.col>ol.pas1[start="3" type="A"]>li{\$C\$}+li{\$D\$}*
    </PILIHAN-GANDA-TANPA-GAP>

    PILIHAN-GANDA-DENGAN-GAP
    .w3-row>(.w3-col.s6>ol.pas1[type="A"]>(li.pb{A}+li.pb{B}+li{C}))+.w3-col.s6>ol.pas1[start="4"
    type="A"]>(li.pb{D}+li{E})*

    <TIPE>
        - Standar
        h2{Tipe:
        }+.w3-bar.w3-border.w3-round>(span#standar.w3-bar-item.w3-deep-purple.w3-hide{Standar}+a:blank#snbt.w3-bar-item.w3-button.w3-hide{SNBT}+a:blank#hots.w3-bar-item.w3-button.w3-hide{HOTS})*
        -SNBT
        h2{Tipe:
        }+.w3-bar.w3-border.w3-round>(a:blank#standar.w3-bar-item.w3-button.w3-hide{STANDAR}+span#snbt.w3-bar-item.w3-deep-purple.w3-hide{SNBT}+a:blank#hots.w3-bar-item.w3-button.w3-hide{HOTS})*
        -HOTS
        h2{Tipe:
        }+.w3-bar.w3-border.w3-round>(a:blank#standar.w3-bar-item.w3-button.w3-hide{STANDAR}+a:blank#snbt.w3-bar-item.w3-button.w3-hide{SNBT}+span#hots.w3-bar-item.w3-deep-purple.w3-hide{HOTS})*
    </TIPE>

    NAVIGASI
    br*2+.navi.w3-hide.w3-bar.w3-border.w3-round+br*

    PAKET NOMOR
    .justify#>(h2{No.
    }>span.w3-badge.w3-red.nomor)+{soal}+(.bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank{SUMBER})+(details>(summary.peny{ALTERNATIF
    PENYELESAIAN}+.w3-card-4>(.w3-padding.w3-sand.flo{isi}+.w3-brown.w3-padding.tebal.flo{Jadi, }>(br+b{JAWAB:
    })+button.w3-button.w3-black.w3-padding-small.w3-right[onclick="this.closest('details').removeAttribute('open');"]{TUTUP})))+hr*

    #>(h3{No.
    }>span.badge.w3-red.nomor)+{soal}+(.blockquote-footer.text-end.pt-2>a:blank{SUMBER})+(details>summary.peny{ALTERNATIF
    PENYELESAIAN}+.card>.card-body.flo{isi}+.card-footer.tebal.flo{Jadi, }>br+b{JAWAB: })+hr*

    PEMBAHASAN
    (details>summary.peny{ALTERNATIF
    PENYELESAIAN}+.w3-card-4>.w3-padding.w3-sand.flo+.w3-brown.w3-padding.tebal.flo{Jadi, }>br+b{JAWAB:
    }+button.w3-button.w3-black.w3-padding-small.w3-right[onclick="this.parentNode.parentNode.parentNode.removeAttribute('open');"]{TUTUP})+hr*

    CARA BIASA CARA CEPAT
    table.table.table-bordered>(thead.table-dark>(th.text-center>b{CARA BIASA})+(th.text-center>b{CARA
    CEPAT}))+tbody>tr>td*

    CARA CEPAT
    details>summary.peny{CARA CEPAT}+div.card>div.card-body.flo*

    TABLE BIASA
    table.tengah>tbody>(tr>td*)*
    table.tengah>(thead>th*)+tbody>(tr>td*)*

    SUMBER
    .bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank{SUMBER}*
    .bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank{Matematika Zone Indonesia}*
    .bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank[href="https://s.id/matematikaidhamdaz"]{Grup
    Whatsapp}*

    SCRIPT AUTORENDER
    script:src
</soal>
