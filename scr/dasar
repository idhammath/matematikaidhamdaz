    .w3-card-4>(header.w3-container.w3-teal>h3{CONTOH SOAL})+.w3-container.w3-light-gray>.justify#>(h3{No.
    }>span.w3-badge.w3-red.nomor)+{soal}+(.bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank{SUMBER})+(details>(summary.peny{ALTERNATIF
    PENYELESAIAN}+.w3-card-4>(.w3-padding.w3-sand.flo{isi}+.w3-brown.w3-padding.tebal.flo{Jadi, }>(br+b{JAWAB:
    })+button.w3-button.w3-black.w3-padding-small.w3-right[onclick="this.parentNode.parentNode.parentNode.removeAttribute('open');"]{TUTUP})))+hr*
    .w3-card-4>h3.w3-container.w3-teal{&nbsp;&nbsp;&nbsp;✍️CONTOH SOAL}+.w3-container.w3-light-gray>.justify#>(h3{No.
    }>span.w3-badge.w3-red.nomor)+{soal}+(.bq.w3-right.w3-panel.w3-leftbar.w3-light-grey.w3-cursive>a:blank{SUMBER})+(details>(summary.peny{ALTERNATIF
    PENYELESAIAN}+.w3-card-4>(.w3-padding.w3-sand.flo{isi}+.w3-brown.w3-padding.tebal.flo{Jadi, }>(br+b{JAWAB:
    })+button.w3-button.w3-black.w3-padding-small.w3-right[onclick="this.parentNode.parentNode.parentNode.removeAttribute('open');"]{TUTUP})))+hr*

    BUKTI
    details>summary.bukti{BUKTI}+.w3-card-4>.w3-padding.w3-pale-green.flo+.w3-brown.w3-padding.tebal.flo>button.w3-button.w3-black.w3-padding-small.w3-right[onclick="this.parentNode.parentNode.parentNode.removeAttribute('open');"]{TUTUP}*
